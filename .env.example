# ── Snowflake (ingestion pipeline & dashboard) ───────────────────────────────
SNOWFLAKE_ACCOUNT=your-org-account           # e.g. abc12345.eu-west-1
SNOWFLAKE_USER=FIGURINE_USER

# Used by the dashboard (SQLAlchemy password auth)
SNOWFLAKE_PASSWORD=your-password

# Used by the ingestion pipeline (Snowpipe JWT key-pair auth)
# Paste the base64 body of your PKCS8 private key WITHOUT the header/footer lines
PRIVATE_KEY=your-rsa-private-key-body-here

# ── Kafka topic (file-based broker) ──────────────────────────────────────────
KAFKA_TOPIC=figurine_data_topic              # default value, can be omitted

# ── Anthropic Claude (AI features in the dashboard) ──────────────────────────
# Required for: Strategic AI Summary, Interactive SQL Chat, NL Query responses
# If omitted, the dashboard will prompt for the key in the sidebar at runtime.
ANTHROPIC_API_KEY=sk-ant-your-key-here
